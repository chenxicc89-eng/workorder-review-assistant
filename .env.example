# ================================
# 12345回单智能预审助手 - 环境配置
# ================================
# 复制本文件为 .env 后填写。所有字段均可留空 —— 留空或 AI_ENABLED=false 时
# 系统自动使用 mock 模式(基于本地规则引擎的确定性模拟审核),项目照样完整可跑。

# 后端服务端口
PORT=3001

# ---- 数据库 (SQLite, 相对 prisma/schema.prisma) ----
DATABASE_URL="file:./dev.db"

# ---- AI 大模型配置 ----
# 是否启用真实 AI 调用。false 或未填 API Key 时使用 mock。
AI_ENABLED=false

# provider 目前抽象为 OpenAI 兼容协议,可对接 OpenAI / DeepSeek / Qwen / Kimi / 硅基流动 等。
# 取值:openai
AI_PROVIDER=openai

# 你的 API Key(不要提交到仓库)
AI_API_KEY=

# OpenAI 兼容 Base URL。示例:
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi:        https://api.moonshot.cn/v1
#   硅基流动:     https://api.siliconflow.cn/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称,示例:gpt-4o-mini / deepseek-chat / qwen-plus / moonshot-v1-8k
AI_MODEL=gpt-4o-mini

# ---- 图片识别(OCR)视觉模型 ----
# 用于「上传工单图片/PDF 自动识别」。
# 视觉可以与文本审核用【不同服务商】(如文本走 DeepSeek、图片走 OpenAI)。
# 以下三项留空则各自回退到上面文本那套(AI_MODEL / AI_BASE_URL / AI_API_KEY)。
#
# 视觉模型名,示例:gpt-4o / qwen-vl-max / doubao-1.5-vision-pro / glm-4v
AI_VISION_MODEL=
# 视觉服务 Base URL(与文本不同家时必填)。留空复用 AI_BASE_URL。
AI_VISION_BASE_URL=
# 视觉服务 API Key(与文本不同家时必填)。留空复用 AI_API_KEY。
AI_VISION_API_KEY=
#
# 示例:文本用 DeepSeek、图片用 OpenAI
#   AI_ENABLED=true
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_API_KEY=<你的 DeepSeek Key>
#   AI_MODEL=deepseek-chat
#   AI_VISION_BASE_URL=https://api.openai.com/v1
#   AI_VISION_API_KEY=<你的 OpenAI Key>
#   AI_VISION_MODEL=gpt-4o
#
# 说明:上传 Word(.docx)/Excel(.xlsx) 走【文本模型】(上面的 AI_MODEL,如 DeepSeek),
#       前端解析成文字后交文本模型拆分,不消耗视觉额度,也无需配 AI_VISION_*。
#       只有图片/PDF 才走视觉模型。
