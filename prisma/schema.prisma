// Prisma schema —— PostgreSQL(Vercel Postgres / Neon)
// 需求文档第九节:WorkOrderCase(历史案例)、StandardRule(规范库)
//
// 部署:Vercel Postgres 提供两个连接串:
//   DATABASE_URL —— pooled(运行时用,serverless 并发安全)
//   DIRECT_URL   —— direct(prisma migrate 用)
// 本地开发也需指向一个 Postgres(可直接用同一个云库,或本地 Postgres)。

generator client {
  provider = "prisma-client-js"
  // 本机开发用 native;Vercel serverless 运行在 Amazon Linux 2023(OpenSSL 3.0),
  // 必须显式声明 rhel-openssl-3.0.x,否则运行时找不到查询引擎 → 整个函数冷启动即崩溃,
  // 表现为所有 /api/* 全部 500(含 /api/health)。
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 历史审核案例
model WorkOrderCase {
  id                String   @id @default(cuid())
  orderNo           String?
  orderType         String
  citizenAppeal     String
  replyContent      String
  attachmentNote    String?
  unit              String?
  remark            String?
  conclusion        String
  riskLevel         String
  summaryJson       String // string[] 序列化
  issuesJson        String // ReviewIssue[] 序列化
  reviewOpinion     String
  confidence        Float?
  finalOpinion      String? // 人工修改后的最终意见
  humanEdited       Boolean  @default(false)
  isFalsePositive   Boolean  @default(false)
  falsePositiveNote String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderType])
  @@index([riskLevel])
  @@index([createdAt])
}

/// 回单规范库(RuleStandard 序列化后存 contentJson)
model StandardRule {
  id          String   @id @default(cuid())
  orderType   String
  name        String
  contentJson String // RuleStandard 序列化(不含 id/orderType/name)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderType])
}

/// Tier3:从历史反馈蒸馏出的「学习规则」候选与其生命周期。
/// 本表是候选 pending/adopted/rejected 的真相源与审计;采纳后其 text 会被投影进
/// 对应 StandardRule.contentJson 的 learnedRules/learnedExemptions
/// (审核热路径只读规范,不查本表,故审核延迟不受影响)。
model LearnedRule {
  id                String    @id @default(cuid())
  orderType         String
  /// "reinforce"(加强规则)| "exempt"(豁免规则)
  kind              String
  /// 规则正文(采纳后写入规范的那句话)
  text              String
  /// 提炼理由(给人工看,不进审核 prompt)
  rationale         String
  /// "pending" | "adopted" | "rejected"
  status            String    @default("pending")
  /// 加强规则的建议风险等级(exempt 可空)
  riskLevel         String?
  confidence        Float?
  /// 支撑该规则的历史案例 id(string[] 序列化,沿用 summaryJson 风格)
  supportingCaseIds String
  /// 同一批「生成候选」的批次标识
  sourceBatchId     String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  adoptedAt         DateTime?

  @@index([orderType])
  @@index([status])
}
